Windows Registry Editor Version 5.00

; Uninstall — removes the uBO force-install policy for Yandex Browser. Run elevated, restart it.
; Deletes only uBO's entry; other ExtensionSettings policies stay.
; Managed-device step is separate — run fake-mdm-undo.reg to undo that.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\YandexBrowser\ExtensionSettings]
"cbmpaamhmhdhnkofemgdlnbdadbpmjkn"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\YandexBrowser]
"DeveloperToolsAvailability"=-
