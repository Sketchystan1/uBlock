Windows Registry Editor Version 5.00

; Uninstall — removes the uBO force-install policy for Chrome. Run elevated, restart Chrome.
; Deletes only uBO's entry; other ExtensionSettings policies stay.
; Managed-device step is separate — run fake-mdm-undo.reg to undo that.
; Also cleans up the OLD ExtensionInstallAllowlist install (no-op if you never used it).

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionSettings]
"cbmpaamhmhdhnkofemgdlnbdadbpmjkn"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"DeveloperToolsAvailability"=-

; --- old ExtensionInstallAllowlist cleanup ---
[-HKEY_CURRENT_USER\SOFTWARE\Google\Chrome\Extensions\cbmpaamhmhdhnkofemgdlnbdadbpmjkn]

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist]
"1"=-
